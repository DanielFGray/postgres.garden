{
  "name": "postgres-garden",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:client": "vite dev",
    "dev": "mprocs 'bun dev:server' 'bun db:watch' 'bun worker' 'bun test:watch' 'bun typecheck:watch' 'bun build:renderer --watch' 'bun build:webviews --watch' 'effect-devtui'",
    "dev:server": "bun --hot server/index.ts 2>&1 | tee -a ./server.log",
    "predev": "run-s db:ensure",
    "prebuild": "rm -fr dist",
    "build:server": "NODE_ENV=production bun scripts/serverBuild.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:webviews": "vite build --config vite.webviews.config.ts",
    "build:client": "vite build",
    "build:copy-webviews": "mkdir -p dist/src && cp -r src/webview-dist dist/src/",
    "build": "run-s build:server build:webviews build:renderer build:client build:copy-webviews",
    "start": "NODE_ENV=production bun dist/server.js",
    "migrate": "graphile-migrate migrate",
    "start:prod": "bun run migrate && bun run worker:schema:prod && bun run start",
    "deploy": "bun run start",
    "format": "oxfmt",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck:watch": "tsc --noEmit --watch",
    "typecheck:main": "tsc --noEmit",
    "typecheck:sw": "tsc --noEmit -p tsconfig.sw.json",
    "typecheck": "run-s typecheck:main typecheck:sw",
    "start:debugServer": "bun server/debugServer.ts",
    "pw": "bunx playwright test --project=chromium",
    "pw:firefox": "bunx playwright test --project=firefox",
    "pw:ui": "bunx playwright test --ui",
    "pw:headed": "bunx playwright test --headed --project=chromium",
    "ast-grep": "ast-grep scan --globs '!tools/ast-grep/tests/**'",
    "test:unit": "bun --env-file=.env vitest run",
    "test:watch": "bun --env-file=.env vitest --watch",
    "test:e2e": "bunx playwright test --project=chromium",
    "test": "run-s -c typecheck lint ast-grep test:unit test:e2e",
    "worker": "bun --cwd=worker --env-file=../.env graphile-worker",
    "worker:prod": "bun --cwd=worker graphile-worker",
    "worker:schema:prod": "bun --cwd=worker graphile-worker --schema-only",
    "worker:schema": "run-s 'worker --schema-only'",
    "env:init": "bun scripts/generateEnvFile.ts",
    "gm": "bun --env-file=.env -b graphile-migrate",
    "signoz:up": "docker compose -f docker-compose.dev.yml up -d signoz-otel-collector signoz signoz-schema-migrator-async signoz-schema-migrator-sync signoz-clickhouse signoz-zookeeper",
    "db:init": "bun scripts/dbSetup.ts",
    "db:ensure": "bun scripts/dbEnsure.ts",
    "db:up": "ops dev db up && docker compose -f docker-compose.dev.yml up -d valkey",
    "db:latest": "run-s 'gm watch --once'",
    "db:watch": "run-s 'gm watch'",
    "db:reset": "ops dev db reset postgres_garden && bun run db:latest && bun run worker:schema",
    "db:stop": "ops dev db down",
    "db:exec": "docker exec -it ops-dev-pg17",
    "db:types": "kysely-codegen",
    "db:setup": "run-s db:up db:latest",
    "init": "NOCONFIRM=1 run-s env:init db:setup worker:schema",
    "devtui": "effect-devtui",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
