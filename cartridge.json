{
  "apiVersion": "server-ansible/v2",
  "name": "postgres-garden",
  "postgres": [
    {
      "database": "postgres_garden",
      "extensions": ["btree_gin", "citext", "fuzzystrmatch", "pg_trgm", "pgcrypto", "uuid-ossp"]
    }
  ],
  "valkey": {},
  "services": [
    {
      "name": "postgres-garden-server",
      "image": "registry.cluster:5000/postgres-garden",
      "hostPort": "dynamic",
      "containerPort": 3000,
      "healthCheck": { "type": "http", "path": "/healthz" },
      "cpu": 300,
      "memoryMB": 768,
      "networkMode": "bridge",
      "command": "bun",
      "args": ["run", "start:prod"],
      "routes": [
        {
          "host": "postgres.garden",
          "responseHeaders": [
            { "name": "Cross-Origin-Embedder-Policy", "value": "credentialless" },
            { "name": "Cross-Origin-Opener-Policy", "value": "same-origin" },
            { "name": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
          ]
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "OTEL_TRACES_EXPORTER", "value": "otlp" },
        { "name": "OTEL_LOGS_EXPORTER", "value": "otlp" },
        { "name": "PORT", "value": "3000" },
        { "name": "VITE_ROOT_URL", "value": "https://postgres.garden" },
        { "name": "DATABASE_NAME", "value": "postgres_garden" },
        { "name": "DATABASE_OWNER", "database": "postgres_garden", "role": "owner" },
        { "name": "DATABASE_VISITOR", "database": "postgres_garden", "role": "visitor" },
        { "name": "MAIL_PROVIDER", "value": "cloudflare" },
        { "name": "EMAIL_FROM", "value": "postgres.garden <noreply@postgres.garden>" },
        { "name": "VALKEY_KEY_PREFIX", "valkey": "keyPrefix" },
        { "name": "TRUSTED_PROXY_HEADER", "value": "x-real-ip" }
      ],
      "connections": [],
      "secrets": [
        {
          "_tag": "PostgresCredentials",
          "database": "postgres_garden",
          "login": "migration",
          "urlEnv": "DATABASE_URL"
        },
        {
          "_tag": "PostgresCredentials",
          "database": "postgres_garden",
          "login": "api",
          "urlEnv": "AUTH_DATABASE_URL"
        },
        { "_tag": "ValkeyCredentials", "urlEnv": "VALKEY_URL" },
        {
          "_tag": "KvSecret",
          "path": "secret/data/postgres-garden",
          "key": "github_client_id",
          "env": "GITHUB_CLIENT_ID"
        },
        {
          "_tag": "KvSecret",
          "path": "secret/data/postgres-garden",
          "key": "github_client_secret",
          "env": "GITHUB_CLIENT_SECRET"
        },
        {
          "_tag": "KvSecret",
          "path": "secret/data/postgres-garden",
          "key": "github_pat",
          "env": "GITHUB_PAT"
        },
        {
          "_tag": "KvSecret",
          "path": "secret/data/postgres-garden",
          "key": "cloudflare_email_api_token",
          "env": "CLOUDFLARE_EMAIL_API_TOKEN"
        }
      ]
    }
  ]
}
