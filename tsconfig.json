{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM"],
    "types": ["node", "bun"],
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "strict": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "experimentalDecorators": true,
    "noUncheckedIndexedAccess": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "preserveSymlinks": true,
    "paths": {
      "lib/*": ["./lib/*"],
      "generated/*": ["./generated/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "refactors": true,
        "diagnostics": true,
        "quickinfo": true,
        "completions": true,
        "namespaceImportPackages": ["effect", "@effect/*"],
        "diagnosticSeverity": {
          "abortControllerInEffect": "warning",
          "asyncFunction": "warning",
          "cryptoRandomUUID": "warning",
          "cryptoRandomUUIDInEffect": "warning",
          "extendsNativeError": "warning",
          "globalConsole": "warning",
          "globalConsoleInEffect": "warning",
          "globalDate": "warning",
          "globalDateInEffect": "warning",
          "globalFetch": "warning",
          "globalFetchInEffect": "warning",
          "globalRandom": "warning",
          "globalRandomInEffect": "warning",
          "globalTimers": "warning",
          "globalTimersInEffect": "warning",
          "instanceOfSchema": "warning",
          "newPromise": "warning",
          "nodeBuiltinImport": "warning",
          "globalJsonInEffect": "warning",
          "processEnv": "warning",
          "processEnvInEffect": "warning",
          "unsafeEffectTypeAssertion": "warning",
          // effect/http, effect/http-api and effect/ai are unstable throughout Effect 4.0.x.
          // Turn this back on when they are marked stable.
          "unstableApiUsage": "off"
        }
      }
    ]
  },
  "exclude": ["node_modules", "dist", "src/features/notebook/renderer/pev2", "src/sw.ts"],
  "include": ["src", "server", "shared", "lib", "scripts", "worker"]
}
